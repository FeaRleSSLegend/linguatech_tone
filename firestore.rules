rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Admins can update any user
      allow update: if isAdmin();

      // No one can delete users (soft delete with status field instead)
      allow delete: if false;
    }

    // CHATS COLLECTION
    match /chats/{chatId} {
      // Helper function: Check if user is a participant in the chat
      function isParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participants;
      }

      // Helper function: Check if user is a group admin
      function isGroupAdmin() {
        return isAuthenticated() && (
          request.auth.uid == resource.data.creatorId ||
          request.auth.uid in resource.data.admins
        );
      }

      // Helper function: Check if user is the group creator
      function isGroupCreator() {
        return isAuthenticated() && request.auth.uid == resource.data.creatorId;
      }

      // Simplified permissions: authenticated users can create, read chats
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();

      // Participants can update basic fields (lastMessage, updatedAt, blockedBy)
      allow update: if isAuthenticated() && (
        isParticipant() ||
        request.auth.uid == resource.data.creatorId ||
        isAdmin()
      );

      // ADMIN ONLY: Update moderation fields (moderationStats, tempBannedUsers, wordBlacklist)
      allow update: if isAuthenticated() && isGroupAdmin() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStats', 'tempBannedUsers', 'permBannedUsers', 'wordBlacklist', 'updatedAt'
        ])
      );

      // OWNER ONLY: Update group settings (name, description, avatar, strictMode)
      allow update: if isAuthenticated() && isGroupCreator() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'profilePictureUrl', 'strictMode', 'updatedAt'
        ])
      );

      // Participants can delete chats (for conversation reset)
      allow delete: if isParticipant() || isAdmin();
    }

    // MESSAGES COLLECTION
    match /messages/{messageId} {
      // Helper function: Check if user is a participant in the message's chat
      function isMessageParticipant() {
        return isAuthenticated() &&
               request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      }

      // Helper function: Check if user is a group admin for this message's chat
      function isMessageGroupAdmin() {
        let chatDoc = get(/databases/$(database)/documents/chats/$(resource.data.chatId));
        return isAuthenticated() && (
          request.auth.uid == chatDoc.data.creatorId ||
          request.auth.uid in chatDoc.data.admins
        );
      }

      // Helper function: Check if the chat has an active block
      function chatHasActiveBlock(chatId) {
        let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
        return chatDoc.data.blockedBy != null && chatDoc.data.blockedBy.size() > 0;
      }

      // HARD RESTRICTION: Block message creation if chat has any blocks
      allow create: if isAuthenticated() &&
                       !chatHasActiveBlock(request.resource.data.chatId);

      allow read: if isAuthenticated();

      // Only sender or global admin can update messages
      allow update: if isAuthenticated() && (
                       request.auth.uid == resource.data.senderId ||
                       isAdmin()
                     );

      // ENHANCED DELETE: Sender, chat participants (for conversation reset), group admins, or global admin can delete
      allow delete: if isAuthenticated() && (
                       request.auth.uid == resource.data.senderId ||
                       isMessageParticipant() ||
                       isMessageGroupAdmin() ||
                       isAdmin()
                     );
    }

    // FRIEND REQUESTS COLLECTION
    match /friend_requests/{requestId} {
      // Users can read requests they sent or received
      allow read: if isAuthenticated() && (
                     request.auth.uid == resource.data.fromUserId ||
                     request.auth.uid == resource.data.toUserId
                   );

      // Users can create friend requests
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.fromUserId &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.fromUserId != request.resource.data.toUserId;

      // Only the recipient can accept/reject requests
      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.toUserId &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status in ['accepted', 'rejected'];

      // Sender can delete their own pending requests
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.fromUserId &&
                       resource.data.status == 'pending';

      // Admins can do anything
      allow read, write: if isAdmin();
    }

    // REPORTS COLLECTION (Admin only)
    match /reports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();

      // Anyone authenticated can create a report
      allow create: if isAuthenticated();

      // Only admins can update/delete reports
      allow update, delete: if isAdmin();
    }
  }
}
